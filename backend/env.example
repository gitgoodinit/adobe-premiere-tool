# Audio Tools Pro Backend Configuration

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_FILES=5

# File Upload Configuration
MAX_FILE_SIZE=104857600
MAX_FILES_PER_REQUEST=10
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# FFmpeg Configuration
FFMPEG_PATH=/usr/local/bin/ffmpeg
FFPROBE_PATH=/usr/local/bin/ffprobe

# API Keys (Optional)
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_CLOUD_API_KEY=AIza-your-google-cloud-api-key-here

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# Database (if needed in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/audiotools

# Redis (if needed in future)
# REDIS_URL=redis://localhost:6379

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Development
ENABLE_HOT_RELOAD=true
ENABLE_DEBUG_MODE=true
ENABLE_MOCK_APIS=false
ENABLE_MOCK_FFMPEG=false
