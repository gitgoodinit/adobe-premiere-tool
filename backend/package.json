{
    "name": "audio-tools-backend",
    "version": "1.0.0",
    "description": "Backend API for Audio Tools Pro - Adobe Premiere Pro Plugin",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "lint": "eslint . --ext .js",
        "format": "prettier --write \"**/*.{js,json}\""
    },
    "keywords": [
        "audio",
        "api",
        "premiere-pro",
        "silence-detection",
        "overlap-detection",
        "multi-track",
        "rhythm-analysis"
    ],
    "author": "Azeem",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "axios": "^1.6.8",
        "form-data": "^4.0.0",
        "uuid": "^9.0.1",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "joi": "^17.12.0",
        "express-rate-limit": "^7.1.5",
        "compression": "^1.7.4",
        "dotenv": "^16.3.1",
        "fluent-ffmpeg": "^2.1.2",
        "node-cache": "^5.1.2",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "nodemon": "^3.0.2",
        "jest": "^29.7.0",
        "supertest": "^6.3.3",
        "eslint": "^8.57.0",
        "prettier": "^3.2.5"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}