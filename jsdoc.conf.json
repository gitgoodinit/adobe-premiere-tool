{
    "source": {
        "include": [
            "./src/",
            "./index.js"
        ],
        "includePattern": "\\.(js|jsx)$",
        "excludePattern": "(node_modules/|dist/|test/)"
    },
    "opts": {
        "destination": "./docs/",
        "recurse": true,
        "template": "node_modules/docdash"
    },
    "plugins": [
        "plugins/markdown"
    ],
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false
    },
    "docdash": {
        "static": true,
        "sort": true,
        "meta": {
            "title": "Audio Tools Pro API Documentation",
            "description": "Professional Audio Analysis & Editing Plugin for Adobe Premiere Pro"
        }
    }
}