{
  "name": "audio-tools-premiere-plugin",
  "version": "2.0.0",
  "description": "Audio Tools Pro - Professional Audio Analysis & Editing Plugin for Adobe Premiere Pro",
  "main": "index.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint src/**/*.js --fix",
    "lint:check": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.js",
    "setup:env": "node scripts/setup-env.js",
    "setup:all": "npm run setup:env && npm run setup:ffmpeg",
    "package": "npm run build && node scripts/package-plugin.js",
    "package:dev": "npm run build:dev && node scripts/package-plugin.js --dev",
    "clean": "rimraf dist build coverage",
    "precommit": "npm run lint && npm run test:ci",
    "validate": "npm run lint:check && npm run format:check && npm run test:ci",
    "docs": "jsdoc -c jsdoc.conf.json",
    "analyze": "webpack-bundle-analyzer dist/assets/*.js"
  },
  "keywords": [
    "adobe",
    "premiere-pro",
    "audio",
    "silence-detection",
    "overlap-detection",
    "cep",
    "extendscript",
    "ffmpeg",
    "whisper",
    "audio-processing",
    "multi-track",
    "ai",
    "transcription",
    "ebu-r128",
    "loudness"
  ],
  "author": {
    "name": "Azeem",
    "email": "azeem@example.com",
    "url": "https://github.com/gitgoodinit"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "form-data": "^4.0.0",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "webpack-bundle-analyzer": "^4.10.1",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "css-loader": "^7.1.1",
    "style-loader": "^4.0.0",
    "file-loader": "^6.2.0",
    "copy-webpack-plugin": "^11.0.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "terser-webpack-plugin": "^5.3.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdoc": "^4.0.2",
    "rimraf": "^5.0.5",
    "cross-env": "^7.0.3"
  },
  "optionalDependencies": {
    "fluent-ffmpeg": "^2.1.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "cep": {
    "manifestVersion": "9.0",
    "bundleId": "com.audiotools.premiereaudioplugin",
    "bundleVersion": "2.0.0",
    "bundleName": "Audio Tools Pro",
    "hostList": [
      {
        "name": "PPRO",
        "version": "[22.0,99.9]"
      }
    ],
    "requiredRuntime": {
      "name": "CSXS",
      "version": "12.0"
    },
    "extensionManifest": {
      "type": "Panel",
      "width": 400,
      "height": 600,
      "minWidth": 300,
      "minHeight": 400,
      "maxWidth": 800,
      "maxHeight": 1000
    }
  },
  "apis": {
    "openai": {
      "endpoint": "https://api.openai.com/v1/audio/transcriptions",
      "model": "whisper-1",
      "required": false,
      "rateLimit": "10/minute"
    },
    "google": {
      "endpoint": "https://speech.googleapis.com/v1/speech:recognize",
      "model": "latest_long",
      "required": false,
      "rateLimit": "10/minute"
    }
  },
  "ffmpeg": {
    "version": ">=5.0.0",
    "binaries": {
      "win32": "./bin/ffmpeg.exe",
      "darwin": "/usr/local/bin/ffmpeg",
      "linux": "/usr/bin/ffmpeg"
    },
    "required": false,
    "features": [
      "silencedetect",
      "astats",
      "loudnorm"
    ]
  },
  "directories": {
    "src": "./src",
    "dist": "./dist",
    "test": "./test",
    "docs": "./docs",
    "bin": "./bin",
    "scripts": "./scripts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitgoodinit/adobe-premiere-tool.git"
  },
  "bugs": {
    "url": "https://github.com/gitgoodinit/adobe-premiere-tool/issues"
  },
  "homepage": "https://github.com/gitgoodinit/adobe-premiere-tool#readme",
  "config": {
    "development": {
      "mockFFmpeg": true,
      "mockAPIs": true,
      "enableDebugConsole": true,
      "logLevel": "debug",
      "hotReload": true,
      "sourceMaps": true
    },
    "production": {
      "mockFFmpeg": false,
      "mockAPIs": false,
      "enableDebugConsole": false,
      "logLevel": "info",
      "hotReload": false,
      "sourceMaps": false,
      "minify": true
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "Chrome >= 88",
    "Firefox >= 85",
    "Safari >= 14"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/**/*.spec.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "env": {
      "browser": true,
      "es2021": true,
      "node": true,
      "jest": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "prettier/prettier": "error",
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  }
}